# ============ 模型层（多模型） ============
# 主力：DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 备用：通义千问（DashScope OpenAI 兼容模式）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地：Ollama（轻任务：改写、压缩、打标）
OLLAMA_BASE_URL=http://localhost:11434/v1

# ============ 任务路由（task -> model） ============
MODEL_REASONING=deepseek-chat
MODEL_FAST=qwen-turbo
MODEL_LOCAL=qwen2.5:7b
MODEL_FALLBACK=deepseek-chat

# ============ Java 业务系统 ============
BUSINESS_API_BASE=http://localhost:8080
BUSINESS_API_TIMEOUT=5

# ============ 鉴权（Java 与 Python 必须用同一个密钥） ============
JWT_SECRET=change-me-to-a-32-byte-random-secret

# ============ Agent 会话状态（SQLite） ============
AGENT_STATE_DB=data/agent_state.db
# 会话与轨迹保留天数（超期由启动清理 / CLI 删除）
SESSION_TTL_DAYS=30

# ============ 应用 ============
APP_ENV=dev
